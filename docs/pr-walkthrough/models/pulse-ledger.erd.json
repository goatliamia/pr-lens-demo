{
  "schema_version": 1,
  "diagram_type": "erd",
  "meta": {
    "title": "Pulse Org Billing & Ledger Schema",
    "output": "pulse-ledger.html",
    "quality_profile": "showcase"
  },
  "entities": [
    {
      "id": "orgs",
      "label": "organizations",
      "row": 0,
      "col": 0,
      "attributes": [
        { "name": "id", "type": "uuid", "key": "pk" },
        { "name": "plan_tier", "type": "text" }
      ]
    },
    {
      "id": "checkout_jobs",
      "label": "checkout_jobs",
      "row": 0,
      "col": 1,
      "attributes": [
        { "name": "id", "type": "uuid", "key": "pk" },
        { "name": "org_id", "type": "uuid", "key": "fk", "references": "orgs.id" },
        { "name": "idempotency_key", "type": "text" },
        { "name": "status", "type": "text" }
      ]
    },
    {
      "id": "org_ledger",
      "label": "org_ledger_entries",
      "row": 0,
      "col": 2,
      "attributes": [
        { "name": "id", "type": "uuid", "key": "pk" },
        { "name": "job_id", "type": "uuid", "key": "fk", "references": "checkout_jobs.id" },
        { "name": "amount_cents", "type": "integer" }
      ]
    }
  ],
  "relationships": [
    { "id": "r_org_jobs", "from": "orgs", "to": "checkout_jobs", "fromCardinality": "one", "toCardinality": "many", "label": "owns" },
    { "id": "r_job_ledger", "from": "checkout_jobs", "to": "org_ledger", "fromCardinality": "one", "toCardinality": "many", "label": "settles" }
  ]
}
